{
  "name": "doggy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Doggy: Express + Prisma + SQLite",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:init": "prisma db push && prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma generate && prisma db seed",
    "studio": "tsx scripts/studio.ts",
    "test": "bash scripts/probar.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
