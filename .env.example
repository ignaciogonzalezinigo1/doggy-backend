# Base SQLite local (relativa a la raíz del repo)
DATABASE_URL="file:./dev.db"
# Puerto de la API
PORT=3000
# Carpeta de las fotos subidas (opcional, por defecto uploads/)
# UPLOADS_DIR=uploads
# Celular de Sofía para la demo (el seed lo usa como su teléfono, para que
# WhatsApp abra un número real). Formato 5491…, sin + ni espacios, por ejemplo
# 5491123456789. No se versiona: va solo en tu .env. Si queda vacía, el seed
# usa un número inventado.
TELEFONO_DEMO_SOFIA=
